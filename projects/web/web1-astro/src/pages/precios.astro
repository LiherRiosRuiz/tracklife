---
import Layout from "../layouts/Layout.astro";
import { APP_URL as appUrl } from "../config";

const plans = [
  {
    name: "Gratis",
    price: "0€",
    period: "para siempre",
    desc: "Todo lo que necesitas para empezar tu transformación.",
    features: [
      "Diario nutricional completo",
      "Registro de entrenamientos",
      "Biométricos completos (peso, HRV, sueño, recuperación)",
      "Coach con recomendaciones diarias",
      "Comunidad y feed social",
      "Sin límite de datos",
    ],
    cta: "Empezar gratis",
    href: `${appUrl}/registro`,
    highlighted: false,
  },
  {
    name: "Pro",
    price: "Próximamente",
    period: "",
    desc: "Funcionalidades avanzadas para atletas y coaches.",
    // OJO: la exportación de datos NO puede listarse aquí. La portabilidad es el
    // art. 20 del RGPD — un derecho, no un producto — así que ponerla tras un muro
    // de pago sería ilícito. Tampoco se mueve a Gratis hasta que exista de verdad.
    features: [
      "Todo lo de Gratis",
      "Wearables (Garmin, Apple Watch)",
      "Análisis avanzado de HRV",
      "Análisis de tendencias a largo plazo",
      "Soporte prioritario",
    ],
    // href a null: el botón "Notificarme" era un <a href="#"> que no notificaba a
    // nadie — no hay captura de emails ni lista de espera en ninguna parte.
    cta: null,
    href: null,
    highlighted: true,
  },
];
---

<Layout
  title="Precios TRACKLIFE — Empieza gratis"
  description="TRACKLIFE es gratis para siempre en sus funcionalidades principales. Sin tarjeta de crédito, sin sorpresas."
>
  <section class="energy max-w-4xl mx-auto px-6 pt-20 pb-8 text-center">
    <h1 class="text-4xl md:text-display font-black mb-4">
      <span class="energy-text">Precios simples</span>
    </h1>
    <p class="text-fg-muted text-lg">Empieza gratis. Siempre.</p>
  </section>

  <section class="max-w-3xl mx-auto px-6 py-16 grid md:grid-cols-2 gap-8">
    {plans.map((plan) => (
      <div class={`rounded-2xl border p-8 flex flex-col ${plan.highlighted ? 'border-accent bg-surface shadow-xl shadow-accent/10' : 'border-border bg-surface'}`}>
        {plan.highlighted && (
          <div class="mb-4 inline-block rounded-full bg-accent px-3 py-1 text-xs font-bold text-on-accent">Próximamente</div>
        )}
        <h2 class="text-2xl font-black mb-1">{plan.name}</h2>
        <div class="mb-1">
          <span class={`text-4xl font-black ${plan.highlighted ? 'text-fg-muted' : 'text-accent'}`}>{plan.price}</span>
          {plan.period && <span class="text-sm text-fg-muted ml-1">{plan.period}</span>}
        </div>
        <p class="text-fg-muted text-sm mb-6">{plan.desc}</p>
        <ul class="space-y-3 mb-8 flex-1">
          {plan.features.map((f) => (
            <li class="flex items-center gap-2 text-sm">
              <span class={plan.highlighted ? 'text-fg-muted' : 'text-accent'} aria-hidden="true">✓</span>
              <span>{f}</span>
            </li>
          ))}
        </ul>
        {plan.href ? (
          <a href={plan.href}
             class="block rounded-xl bg-accent py-3 text-center font-bold text-on-accent transition-colors hover:bg-accent-strong">
            {plan.cta}
          </a>
        ) : (
          /* Sin href no se renderiza un enlace: un <a href="#"> deshabilitado sigue
             siendo enfocable con el teclado y activable, y no llevaba a ningún sitio. */
          <p class="block rounded-xl border border-border py-3 text-center font-bold text-fg-muted">
            Disponible más adelante
          </p>
        )}
      </div>
    ))}
  </section>

  <section class="max-w-2xl mx-auto px-6 pb-20 text-center">
    <p class="text-fg-muted text-sm">
      ¿Preguntas? El código de TRACKLIFE es público —
      <a href="https://github.com/LiherRiosRuiz/tracklife" class="text-accent hover:underline">revísalo tú mismo</a>.
    </p>
  </section>
</Layout>
