---
import Layout from "../layouts/Layout.astro";
import { APP_URL as appUrl } from "../config";

// Los cinco módulos reales de la app (ver components/AppNav.tsx en web3-next).
// Cada afirmación de aquí abajo es comprobable en el código: si una feature no
// existe, no se anuncia.
const modules = [
  {
    icon: "🥗",
    title: "Nutrición",
    desc: "Registra cada comida escaneando el código de barras o buscando el alimento en Open Food Facts, la base de datos abierta de productos. Visualiza tus macros (proteína, carbohidratos, grasa) en tiempo real frente a tus objetivos.",
    features: ["Diario alimentario por comidas", "Búsqueda en Open Food Facts", "Escáner de código de barras", "Tus recetas guardadas", "Objetivos de macros editables"],
  },
  {
    icon: "🏋️",
    title: "Entrenamiento",
    desc: "Planifica tus sesiones con ejercicios de un catálogo abierto —o los tuyos propios—, registra series, pesos y repeticiones, añade cardio y revisa tu volumen semana a semana.",
    features: ["Sesiones de gym con series y pesos", "Planes de entrenamiento reutilizables", "Cardio y actividad libre (registro manual)", "Calendario semanal", "Volumen y progreso por semana"],
  },
  {
    icon: "📊",
    title: "Biométricos",
    desc: "Más allá del peso. Registra tu composición corporal, frecuencia cardíaca, HRV, sueño y recuperación, y mira cómo evolucionan. Todo lo introduces tú: TRACKLIFE no inventa una sola lectura.",
    features: ["Peso y composición corporal", "Frecuencia cardíaca y HRV", "Calidad del sueño", "Índice de recuperación", "Historial con tendencias", "Registro manual — sin wearables todavía"],
  },
  {
    icon: "📈",
    title: "Coach de transformación",
    desc: "Un coach que lee tus datos del día y te dice qué falta: proteína por debajo del objetivo, días sin entrenar, cardio pendiente, recuperación baja. Reglas claras sobre tus números, no una caja negra.",
    features: ["Recomendaciones diarias basadas en tus datos", "Aviso si te falta proteína para tu objetivo", "Aviso si llevas días sin entrenar o sin cardio", "Aviso de recuperación baja", "Tu plan semanal, construido desde tus propios planes"],
  },
  {
    icon: "👥",
    title: "Comunidad",
    desc: "Comparte tus entrenos y comidas si quieres —tú decides qué ve cada persona—, únete a clubs y retos, y mantén tu racha.",
    features: ["Feed con lo que tú compartes", "Visibilidad por categoría (público / seguidores / privado)", "Clubs y retos", "Seguir a otros usuarios", "Racha de días registrando"],
  },
];
---

<Layout
  title="Cómo funciona TRACKLIFE — Plataforma fitness integral"
  description="Descubre cómo TRACKLIFE integra nutrición, entrenamiento, biométricos, coach y comunidad en una sola plataforma para tu transformación física."
>
  <section class="energy max-w-4xl mx-auto px-6 pt-20 pb-8 text-center">
    <h1 class="text-4xl md:text-display font-black mb-4">
      <span class="energy-text">Cómo funciona</span>
    </h1>
    <p class="text-fg-muted text-lg max-w-2xl mx-auto">
      TRACKLIFE conecta cinco módulos en un ecosistema coherente. Los datos de cada módulo alimentan a los demás.
    </p>
  </section>

  <section class="max-w-4xl mx-auto px-6 py-16 space-y-20">
    {modules.map((mod, i) => (
      <div class={`flex flex-col ${i % 2 === 1 ? 'md:flex-row-reverse' : 'md:flex-row'} gap-10 items-center`}>
        <div class="flex-1">
          <div class="text-5xl mb-4" aria-hidden="true">{mod.icon}</div>
          <h2 class="text-2xl md:text-3xl font-black mb-3">{mod.title}</h2>
          <p class="text-fg-muted leading-relaxed mb-6">{mod.desc}</p>
          <ul class="space-y-2">
            {mod.features.map((f) => (
              <li class="flex items-center gap-2 text-sm">
                <span class="text-accent font-bold" aria-hidden="true">✓</span>
                <span>{f}</span>
              </li>
            ))}
          </ul>
        </div>
        <div class="flex-1 rounded-2xl border border-border bg-surface p-10 text-center min-h-48 flex items-center justify-center">
          <span class="text-8xl" aria-hidden="true">{mod.icon}</span>
        </div>
      </div>
    ))}
  </section>

  <section class="energy border-t border-border bg-surface/30 py-20 text-center">
    <h2 class="text-3xl font-black mb-4"><span class="energy-text">¿Listo para empezar?</span></h2>
    <p class="text-fg-muted mb-8">Es gratis. Sin tarjeta de crédito.</p>
    <a href={`${appUrl}/registro`}
       class="energy-btn energy-glow inline-block rounded-2xl px-10 py-4 text-lg font-bold transition-[filter] hover:brightness-110 shadow-hype">
      Crear cuenta gratis
    </a>
  </section>
</Layout>
