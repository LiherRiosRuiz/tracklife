---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Página no encontrada — TRACKLIFE"
  description="Esta página no existe o se movió de lugar."
>
  <section class="relative overflow-hidden">
    <div
      class="pointer-events-none absolute -top-40 left-1/2 h-[60vh] w-[60vh] -translate-x-1/2 rounded-full opacity-25 blur-3xl"
      style="background: radial-gradient(circle, var(--color-accent), transparent 70%)"
    ></div>
    <div class="relative max-w-2xl mx-auto px-6 py-32 text-center">
      <p class="text-6xl font-extrabold tracking-tight brand-gradient mb-4">404</p>
      <h1 class="text-2xl font-bold mb-3">Esta página no existe</h1>
      <p class="text-fg-muted mb-10">
        Puede que se haya movido o que el enlace esté roto.
      </p>
      <a
        href="/"
        class="inline-flex rounded-lg bg-accent px-6 py-3 font-semibold text-on-accent hover:bg-accent-strong transition-colors text-sm"
      >
        Volver al inicio
      </a>
    </div>
  </section>
</Layout>
