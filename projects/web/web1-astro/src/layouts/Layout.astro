---
import "../styles/global.css";
import { APP_URL as appUrl, SITE_URL } from "../config";

interface Props {
  title: string;
  description: string;
  ogImage?: string;
}

// Defaulted to /favicon.svg and then never rendered into a meta tag at all, so
// the cards went out imageless — and SVG wouldn't have worked anyway: Twitter,
// Facebook, WhatsApp and LinkedIn all reject it for og:image. PNG, absolute URL.
const { title, description, ogImage = "/og-image.png" } = Astro.props;
const siteBase = Astro.site?.toString() ?? SITE_URL;
const canonicalURL = new URL(Astro.url.pathname, siteBase);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#090c0a" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="canonical" href={canonicalURL} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="TRACKLIFE" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:image" content={new URL(ogImage, siteBase)} />
    {/* `summary`, not `summary_large_image`: the brand mark is square, and a wide
        card rendering a square image crops it badly. */}
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, siteBase)} />
  </head>
  <body class="bg-bg text-fg antialiased min-h-screen">
    <nav class="flex items-center justify-between px-6 py-4 max-w-6xl mx-auto border-b border-border">
      <a href="/" class="text-xl font-extrabold tracking-widest brand-gradient">TRACKLIFE</a>
      <div class="flex items-center gap-6 text-sm">
        <a href="/como-funciona" class="text-fg-muted hover:text-fg transition-colors hidden sm:inline">Cómo funciona</a>
        <a href="/precios" class="text-fg-muted hover:text-fg transition-colors hidden sm:inline">Precios</a>
        <a href={`${appUrl}/login`} class="text-fg-muted hover:text-fg transition-colors">Entrar</a>
        <a href={`${appUrl}/registro`}
           class="rounded-lg bg-accent px-4 py-2 font-semibold text-on-accent hover:bg-accent-strong transition-colors text-sm">
          Empezar gratis
        </a>
      </div>
    </nav>
    <main>
      <slot />
    </main>
    <footer class="border-t border-border mt-24 py-12 text-center text-sm text-fg-muted">
      <p class="mb-2 font-extrabold tracking-widest brand-gradient">TRACKLIFE</p>
      <p>© 2026 — Transformación física basada en datos</p>
      <div class="mt-4 flex justify-center gap-6 text-xs">
        <a href="/como-funciona" class="hover:text-accent transition-colors">Cómo funciona</a>
        <a href="/precios" class="hover:text-accent transition-colors">Precios</a>
        <a href={`${appUrl}/registro`} class="hover:text-accent transition-colors">Registro</a>
      </div>
    </footer>
  </body>
</html>
