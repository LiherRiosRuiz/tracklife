# Public domain used in Traefik Host() rules. Leave unset to use the local default (tracklife.test).
DOMAIN=tracklife.test

# CSP middleware for this router. Leave unset/empty for local dev — npm run dev's HMR
# needs 'unsafe-eval', which the CSP blocks. Set to sec-csp-app@file in production,
# once verified against a production build.
WEB_CSP_MIDDLEWARE=

# Leave false for local dev (plain HTTP), set to true only in production once a real
# domain/cert is active.
WEB_TLS_ENABLED=false
